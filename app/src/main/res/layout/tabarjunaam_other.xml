<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/menu_1"
    android:padding="9dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="1dp">
    <LinearLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="35dp">
        <TextView
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MARCADORES DE COMPETICIONES"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:background="@drawable/button"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <TextView
            android:textColor="#ffffffff"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Champions League ida"
            android:layout_weight="1"/>
        <arjuna.am.power.g.Button
            android:id="@+id/button7"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="3dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/button"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <TextView
            android:textColor="#ffffffff"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Champions League vuelta"
            android:layout_weight="1"/>
        <arjuna.am.power.t.Button
            android:id="@+id/button20"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="3dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/button"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <TextView
            android:textColor="#ffffffff"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Europa League ida"
            android:layout_weight="1"/>
        <arjuna.am.power.s.Button
            android:id="@+id/button19"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="3dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/button"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <TextView
            android:textColor="#ffffffff"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Europa League vuelta"
            android:layout_weight="1"/>
        <arjuna.am.power.j.Button
            android:id="@+id/button10"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="3dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/button"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
