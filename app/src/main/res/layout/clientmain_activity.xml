<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/pengaturan_bg"
    android:padding="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="1dp">
    <TextView
        android:textColor="#ffffffff"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="------FTS 27 BY GIIODROID, DROICER, AR GAMING Y FTS PERU------"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="15sp"
        android:typeface="monospace"
        android:textColor="#ffffffff"
        android:ellipsize="marquee"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:text="CREDITS: GIIODROID, DROICER, AR GAMING Y FTS PERU"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <View
        android:background="@drawable/button"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <arjuna.am.power.button
            android:textColor="#ffffffff"
            android:background="@drawable/button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="LIGAS Y COPAS"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <arjuna.am.power.sbButton
            android:textColor="#ffffffff"
            android:background="@drawable/button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="LIGAS Y COPAS"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <arjuna.am.power.OtherButton
            android:textColor="#ffffffff"
            android:background="@drawable/button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="COMPETICIONES"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <arjuna.am.power.IdiomaComentariosButton
            android:textColor="#ffffffff"
            android:background="@drawable/button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="IDIOMA DE COMENTARIOS"/>
    </LinearLayout>
</LinearLayout>
