<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/menu_1"
        android:padding="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="35dp">
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idioma de los comentarios"/>
        </LinearLayout>
        <View
            android:background="@drawable/button"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="35dp">
            <TextView
                android:textColor="#ffffffff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Fernando Palomo (Español)"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnPlayPalomo"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="▶"
                android:onClick="playPalomo"/>
            <Button
                android:id="@+id/btnDownloadPalomo"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="⬇"
                android:onClick="downloadPalomo"/>
        </LinearLayout>
        <View
            android:background="@drawable/button"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="35dp">
            <TextView
                android:textColor="#ffffffff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cristian Martinoli (Español)"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnPlayMartinoli"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="▶"
                android:onClick="playMartinoli"/>
            <Button
                android:id="@+id/btnDownloadMartinoli"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="⬇"
                android:onClick="downloadMartinoli"/>
        </LinearLayout>
        <View
            android:background="@drawable/button"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="35dp">
            <TextView
                android:textColor="#ffffffff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Rodolfo De Paoli y Diego Latorre (Español)"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnPlayDepaoliLatorre"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="▶"
                android:onClick="playDepaoliLatorre"/>
            <Button
                android:id="@+id/btnDownloadDepaoliLatorre"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="⬇"
                android:onClick="downloadDepaoliLatorre"/>
        </LinearLayout>
        <View
            android:background="@drawable/button"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="35dp">
            <TextView
                android:textColor="#ffffffff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Gary Bloom (Inglés)"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnPlayBloom"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="▶"
                android:onClick="playBloom"/>
            <Button
                android:id="@+id/btnDownloadBloom"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="⬇"
                android:onClick="downloadBloom"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
