<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <arjuna.am.power.a.Content
        android:id="@+id/content1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="top|center_horizontal"
            android:layout_gravity="top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/fa_cup"
            android:scaleType="fitXY"/>
    </arjuna.am.power.a.Content>
    <arjuna.am.power.b.Content
        android:id="@+id/content2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="top|center_horizontal"
            android:layout_gravity="top"
            android:background="@drawable/efl_championship"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </arjuna.am.power.b.Content>
    <arjuna.am.power.c.Content
        android:id="@+id/content3"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="top|center_horizontal"
            android:layout_gravity="top"
            android:background="@drawable/la_liga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </arjuna.am.power.c.Content>
    <arjuna.am.power.d.Content
        android:id="@+id/content4"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="top|center_horizontal"
            android:layout_gravity="top"
            android:background="@drawable/copadel_rey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </arjuna.am.power.d.Content>
    <arjuna.am.power.e.Content
        android:id="@+id/content5"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="top|center_horizontal"
            android:layout_gravity="top"
            android:background="@drawable/bundesliga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </arjuna.am.power.e.Content>
    <arjuna.am.power.f.Content
        android:id="@+id/content6"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="top|center_horizontal"
            android:layout_gravity="top"
            android:background="@drawable/premierleaguev1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </arjuna.am.power.f.Content>
    <arjuna.am.power.u.Content
        android:id="@+id/content21"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="top|center_horizontal"
            android:layout_gravity="top"
            android:background="@drawable/dfb_pokal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </arjuna.am.power.u.Content>
    <arjuna.am.power.w.Content
        android:id="@+id/content23"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:gravity="top|center_horizontal"
            android:layout_gravity="top"
            android:background="@drawable/ligue1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </arjuna.am.power.w.Content>
</FrameLayout>
