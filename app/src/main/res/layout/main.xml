<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <view
        android:id="@+id/glsurfaceview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        class="com.firsttouchgames.fts15.GLSurfaceView"/>
    <include layout="@layout/arjunaam_ps_r2"/>
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="right"
        android:background="#00000000"
        android:layout_width="95dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:layout_alignParentRight="true">
        <arjuna.am.power.app
            android:textColor="#00000000"
            android:background="@drawable/krik2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Daftar Channel"/>
    </FrameLayout>
    <include layout="@layout/arjunaam_s_r3"/>
    <include layout="@layout/arjunaam_c_r1"/>
    <FrameLayout
        android:id="@+id/adLayout"
        android:background="#ff887766"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/bannerframe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.mopub.mobileads.MoPubView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
</FrameLayout>
